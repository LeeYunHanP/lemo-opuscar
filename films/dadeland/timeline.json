 "voice": [
  {
   "id": "l01",
   "t": 0.5,
   "d": 3.722,
   "sub": "In GTA 6, you can rob a store in broad daylight.",
   "t1": 4.822
  },
  {
   "id": "l02",
   "t": 4.9,
   "d": 3.103,
   "sub": "In real Miami, something worse actually happened.",
   "t1": 8.603
  },
  {
   "id": "l03",
   "t": 8.7,
   "d": 2.621,
   "sub": "July 11th, 1979.",
   "t1": 11.921
  },
  {
   "id": "l04",
   "t": 12.9,
   "d": 3.527,
   "sub": "Dadeland Mall, one of the busiest shopping centers in the city.",
   "t1": 17.027
  },
  {
   "id": "l05",
   "t": 17.1,
   "d": 2.979,
   "sub": "A delivery van pulls up outside a liquor store.",
   "t1": 20.65
  },
  {
   "id": "l06",
   "t": 20.7,
   "d": 3.356,
   "sub": "Two men walk in, and seconds later the gunfire starts.",
   "t1": 24.656
  },
  {
   "id": "l07",
   "t": 25.7,
   "d": 4.286,
   "sub": "Automatic weapons, in the middle of the afternoon, with shoppers all around.",
   "t1": 30.586
  },
  {
   "id": "l08",
   "t": 31.0,
   "d": 2.295,
   "sub": "Two men inside the store were killed.",
   "t1": 33.895
  },
  {
   "id": "l09",
   "t": 34.0,
   "d": 1.599,
   "sub": "The shooters got away.",
   "t1": 36.199
  },
  {
   "id": "l10",
   "t": 36.6,
   "d": 4.447,
   "sub": "Police connected the attack to the cocaine trade that was taking over the city,",
   "t1": 41.647
  },
  {
   "id": "l11",
   "t": 41.7,
   "d": 4.419,
   "sub": "and the newspapers gave this new kind of killer a name: the Cocaine Cowboys.",
   "t1": 46.719
  },
  {
   "id": "l12",
   "t": 46.9,
   "d": 3.944,
   "sub": "That afternoon is part of the real history behind Vice City.",
   "t1": 51.444
  },
  {
   "id": "l13",
